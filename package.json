{
  "name": "@stark/eslint-config",
  "version": "0.1.0",
  "description": "Composable ESLint 9 flat-config fragments for JavaScript and TypeScript",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "tsc --project jsconfig.json"
  },
  "dependencies": {
    "@eslint/js": "9.39.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "typescript-eslint": "8.65.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "devDependencies": {
    "eslint": "9.39.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "license": "UNLICENSED"
}
